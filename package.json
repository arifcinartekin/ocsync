{
	"name": "ocsync",
	"version": "0.1.0",
	"description": "End-to-end encrypted, GitHub-based bidirectional sync plugin for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "node scripts/test-decide-action.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"encryption",
		"sync",
		"github"
	],
	"author": "arifcinartekin",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.14.2",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.21.5",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.4.5"
	}
}
